# ===========================================
# payment-core - Environment Variables Example
# ===========================================
# Este archivo documenta las variables que payment-core necesita.
# NO usar este archivo directamente - copiar variables a la app que consume el package.

# ============================================
# UBICACIÓN DE VARIABLES EN LAS APPS
# ============================================
# 
# Variables de configuración → gym/.env.payment
# Variables secretas → gym/.env.secrets
#
# Las apps que usan payment-core deben:
# 1. Copiar las variables necesarias a sus .env
# 2. Llamar validatePaymentEnv() al inicio
# 3. Pasar las variables al PaymentClient

# ============================================
# VARIABLES DE CONFIGURACIÓN (gym/.env.payment)
# ============================================

# MercadoPago - Configuración
MERCADOPAGO_CALLBACK_URL=http://localhost:3000/api/payments/mercadopago/oauth/callback

# Storage - Configuración de almacenamiento
PAYMENT_STORAGE_TYPE=prisma
PAYMENT_PRISMA_URL=file:./dev.db

# ============================================
# VARIABLES SECRETAS (gym/.env.secrets)
# ============================================
# ⚠️ NUNCA commitear estos valores reales
# ⚠️ Estas variables deben ir en gym/.env.secrets

# MercadoPago OAuth Credentials
# Obtener en: https://www.mercadopago.com/developers/panel/app
MERCADOPAGO_CLIENT_ID=tu_client_id_aqui
MERCADOPAGO_CLIENT_SECRET=tu_client_secret_aqui
MERCADOPAGO_WEBHOOK_SECRET=tu_webhook_secret_aqui

# ============================================
# VARIABLES VALIDADAS POR validatePaymentEnv()
# ============================================
# El package valida automáticamente estas 5 variables:
#
# 1. MERCADOPAGO_CLIENT_ID (secret)
# 2. MERCADOPAGO_CLIENT_SECRET (secret)
# 3. MERCADOPAGO_WEBHOOK_SECRET (secret)
# 4. MERCADOPAGO_CALLBACK_URL (config)
# 5. PAYMENT_STORAGE_TYPE (config)
#
# Si falta alguna, la app falla al inicio con mensaje claro.

# ============================================
# USO EN LAS APPS
# ============================================
#
# En gym/apps/admin/src/config/env.ts:
#
# import { validatePaymentEnv } from '@onlemary/payment-core/config'
# 
# // Valida las 5 variables obligatorias
# validatePaymentEnv()
#
# // Luego usar PaymentClient normalmente
# const client = new PaymentClient({ ... })

# ============================================
# TESTING
# ============================================
# Para testing, usar valores de prueba de MercadoPago:
# https://www.mercadopago.com/developers/es/docs/checkout-api/additional-content/test-cards
