generator client {
  provider = "prisma-client-js"
  output   = "../dist/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model OAuthToken {
  userId       BigInt   @id @map("user_id")
  orgSlug      String   @map("org_slug") @db.VarChar(255)
  accessToken  String   @map("access_token")
  refreshToken String?  @map("refresh_token")
  expiresAt    DateTime? @map("expires_at")
  connectedAt  DateTime? @map("connected_at")
  publicKey    String?  @map("public_key")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("oauth_tokens")
}

model TransferIntent {
  id           String   @id @default(uuid())
  orgSlug      String   @map("org_slug") @db.VarChar(255)
  transferCode String   @unique @map("transfer_code")
  amount       Int
  currency     String   @default("ARS")
  invoiceIds   Json     @map("invoice_ids")
  status       String   @default("pending")
  matchedAt    DateTime? @map("matched_at")
  transferId   String?  @map("transfer_id")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  metadata     Json?

  @@index([orgSlug])
  @@map("transfer_intents")
}

model PendingTransfer {
  id        String   @id @default(uuid())
  orgSlug   String   @map("org_slug") @db.VarChar(255)
  transferId String  @map("transfer_id")
  amount    Int
  currency  String   @default("ARS")
  concept   String?
  status    String   @default("unassigned")
  receivedAt DateTime @default(now()) @map("received_at")
  assignedBy String?  @map("assigned_by")
  assignedAt DateTime? @map("assigned_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([orgSlug])
  @@map("pending_transfers")
}

model MpUserOrg {
  mpUserId  BigInt   @id @map("mp_user_id")
  orgSlug   String   @map("org_slug") @db.VarChar(255)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("mp_user_orgs")
}

model OrgPaymentConfig {
  orgSlug           String   @id @map("org_slug") @db.VarChar(255)
  bankName          String?  @map("bank_name")
  bankAccountHolder  String?  @map("bank_account_holder")
  bankCbu           String?  @map("bank_cbu")
  bankAlias         String?  @map("bank_alias")
  cvuAlias          String?  @map("cvu_alias")
  mpAlias           String?  @map("mp_alias")

  paymentMethods    PaymentMethod[]

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("org_payment_configs")
}

model PaymentMethod {
  id                   String  @id @default(uuid())
  orgSlug              String  @map("org_slug") @db.VarChar(255)
  methodId             String  @map("method_id")
  name                 String
  enabled              Boolean @default(true)
  requiresVerification Boolean @default(false) @map("requires_verification")
  flow                 String?
  provider             String?
  instructions         String?
  icon                 String?
  implementation       String?

  orgPaymentConfig OrgPaymentConfig @relation(fields: [orgSlug], references: [orgSlug], onDelete: Cascade)

  @@unique([orgSlug, methodId])
  @@index([orgSlug])
  @@map("payment_methods")
}

model CheckoutSession {
  sessionId  String   @id @map("session_id")
  paymentId  String   @map("payment_id")
  orgSlug    String   @map("org_slug") @db.VarChar(255)
  provider   String   @default("mercadopago")
  invoiceIds Json     @map("invoice_ids")
  amount     Decimal  @db.Decimal(10, 2)
  currency   String   @default("ARS")
  status     String   @default("created")
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime? @map("expires_at")

  @@index([paymentId])
  @@index([orgSlug])
  @@map("checkout_sessions")
}
