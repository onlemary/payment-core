# ===========================================
# payment-core - Environment Variables Example
# ===========================================
# Este archivo muestra las variables que necesita payment-core
# Copiar estas variables a tu app según la estructura recomendada

# ===========================================
# .env.payment (Configuración - Commiteable)
# ===========================================

# Payment Core Database
PAYMENT_CORE_DB_URL=postgresql://lago:changeme@localhost:54320/payment_core

# Circuit Breaker Configuration
PAYMENT_CB_FAILURE_THRESHOLD=5
PAYMENT_CB_RESET_TIMEOUT_MS=60000
PAYMENT_CB_HALF_OPEN_REQUESTS=3

# ===========================================
# .env.secrets (Secrets - NO COMMITEAR)
# ===========================================

# MercadoPago OAuth
MERCADOPAGO_CLIENT_ID=tu_client_id_aqui
MERCADOPAGO_CLIENT_SECRET=tu_client_secret_aqui
MERCADOPAGO_WEBHOOK_SECRET=tu_webhook_secret_aqui
