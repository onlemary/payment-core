# ===========================================
# @onlemary/payment-core — Environment Variables
# ===========================================
# Copiar las variables a tu .env.payment y .env.secrets.
#
# ═══════════════════════════════════════════════════
#  REQUIRED (validadas por validatePaymentEnv())
# ═══════════════════════════════════════════════════
#   PAYMENT_CORE_DB_URL              → .env.payment  (postinstall la usa)
#   PAYMENT_MP_OAUTH_TEST_MODE       → .env.payment  (true/false)
#   MERCADOPAGO_CLIENT_ID            → .env.secrets
#   MERCADOPAGO_CLIENT_SECRET        → .env.secrets
#   MERCADOPAGO_WEBHOOK_SECRET       → .env.secrets
#   NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY → .env.secrets
#
# ═══════════════════════════════════════════════════
#  OPTIONAL
# ═══════════════════════════════════════════════════
#   MERCADOPAGO_CALLBACK_URL         → .env.payment
#   PAYMENT_STORAGE_TYPE             → .env.payment
#   PAYMENT_PRISMA_URL               → .env.payment
#   PAYMENT_CB_FAILURE_THRESHOLD     → .env.payment
#   PAYMENT_CB_RESET_TIMEOUT_MS      → .env.payment
#   PAYMENT_CB_HALF_OPEN_REQUESTS    → .env.payment

# ════════════════════════════════════════════
# REQUIRED — Database (.env.payment)
# ════════════════════════════════════════════
# Usada por el postinstall para crear DB y por PrismaStorage.
PAYMENT_CORE_DB_URL=postgres://user:pass@host:5432/payment_core

# ════════════════════════════════════════════
# REQUIRED — OAuth Test Mode (.env.payment)
# ════════════════════════════════════════════
# true  → obtiene tokens TEST-xxx (desarrollo)
# false → obtiene tokens APP_USR-xxx (producción)
PAYMENT_MP_OAUTH_TEST_MODE=true

# ════════════════════════════════════════════
# REQUIRED — MercadoPago Credentials (.env.secrets)
# ════════════════════════════════════════════
# Obtener en: https://www.mercadopago.com/developers/panel/app
# MERCADOPAGO_CLIENT_ID=tu_client_id
# MERCADOPAGO_CLIENT_SECRET=tu_client_secret
# MERCADOPAGO_WEBHOOK_SECRET=tu_webhook_secret
# NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-xxxx-xxxx

# ════════════════════════════════════════════
# OPTIONAL — Callback URL (.env.payment)
# ════════════════════════════════════════════
# MERCADOPAGO_CALLBACK_URL=http://localhost:3000/api/payments/mercadopago/oauth/callback

# ════════════════════════════════════════════
# OPTIONAL — Storage (.env.payment)
# ════════════════════════════════════════════
# PAYMENT_STORAGE_TYPE=prisma
# PAYMENT_PRISMA_URL=file:./dev.db

# ════════════════════════════════════════════
# OPTIONAL — Circuit Breaker (.env.payment)
# ════════════════════════════════════════════
# PAYMENT_CB_FAILURE_THRESHOLD=5
# PAYMENT_CB_RESET_TIMEOUT_MS=30000
# PAYMENT_CB_HALF_OPEN_REQUESTS=3
