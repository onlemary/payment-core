# ──────────────────────────────────────────────────────────────────
# @onlemary/payment-core — Environment Variables
# ──────────────────────────────────────────────────────────────────
# Copiá este archivo como .env.payment en la raíz de tu proyecto
# (o donde el postinstall lo encuentre al hacer npm install).
#
# 💡 Una sola fuente de verdad: PAYMENT_CORE_DB_URL
# El package usa exclusivamente PAYMENT_CORE_DB_URL para conectar a Postgres.
# Ignora DATABASE_URL (que suele apuntar a la DB de la app principal).
# Si no seteas PAYMENT_CORE_DB_URL, falla rápido (fail-fast).
# ──────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ─────────────────────────────────────────
# Única fuente de verdad para la DB del payment core.
# Debe ser una conexión directa a Postgres (no a la DB de la app).
PAYMENT_CORE_DB_URL=postgres://user:password@localhost:5432/payment_core_db

# ── MercadoPago — OAuth (Marketplace) ────────────────────────────
# Obligatorias si usás MercadoPago.
MERCADOPAGO_CLIENT_ID=your_client_id
MERCADOPAGO_CLIENT_SECRET=your_client_secret
MERCADOPAGO_WEBHOOK_SECRET=your_webhook_secret

# Public key para tokenización desde el frontend
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-xxxxx-xxxxx

# OAuth Test Mode (obligatorio)
# true → envía test_token:true al hacer OAuth (tokens TEST-xxx)
# false → tokens APP_USR-xxx (producción)
PAYMENT_MP_OAUTH_TEST_MODE=true

# ── MercadoPago — Access Token (opcional si usás OAuth) ──────────
# Si tenés un token fijo (sin marketplace), setealo acá.
# PAYMENT_MP_ACCESS_TOKEN=APP_USR-xxxxx-xxxxx

# ── Stripe (opcional) ────────────────────────────────────────────
# PAYMENT_STRIPE_SECRET_KEY=sk_test_xxxxx
# PAYMENT_STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ── PayPal (opcional) ────────────────────────────────────────────
# PAYMENT_PAYPAL_CLIENT_ID=xxxxx
# PAYMENT_PAYPAL_CLIENT_SECRET=xxxxx
# PAYMENT_PAYPAL_WEBHOOK_ID=xxxxx

# ── Circuit Breaker (opcional, defaults mostrados) ───────────────
# PAYMENT_CB_FAILURE_THRESHOLD=5
# PAYMENT_CB_RESET_TIMEOUT_MS=60000
# PAYMENT_CB_HALF_OPEN_REQUESTS=3
